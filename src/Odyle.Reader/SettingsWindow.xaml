<Window x:Class="Odyle.Reader.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Odyle settings" Width="320" SizeToContent="Height" MaxHeight="680" ResizeMode="CanMinimize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
 Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
 Icon="pack://application:,,,/Odyle;component/Assets/odyle.ico" Closing="Window_Closing"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
  <StackPanel x:Name="Body" Margin="14,6,14,14">

   <!-- Account -->
   <TextBlock Style="{StaticResource Section}" Text="ACCOUNT"/>
   <StackPanel x:Name="JoinPanel">
    <Button x:Name="PasteButton" Content="Paste link &amp; connect"/>
    <TextBlock Style="{StaticResource Hint}" Text="On the dashboard choose Pair Windows app and copy the connection link, or paste it below. You pair once: the app stays connected until you disconnect it." Margin="2,6,0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><PasswordBox x:Name="CodeInput" ToolTip="Connection link or 16-character pairing code"/><Button x:Name="JoinButton" Grid.Column="2" Style="{StaticResource Secondary}" Content="Connect"/></Grid>
    <Expander x:Name="ServerOptions" Header="Server address" Margin="0,4,0,0">
     <StackPanel Margin="0,6,0,0"><TextBox x:Name="EndpointInput" Text="http://127.0.0.1:8090" ToolTip="PocketBase server address"/><Button x:Name="RetryButton" Style="{StaticResource Secondary}" Content="Reconnect saved account" Visibility="Collapsed" Margin="0,6,0,0"/></StackPanel>
    </Expander>
   </StackPanel>
   <StackPanel x:Name="AccountPanel" Visibility="Collapsed">
    <TextBlock x:Name="AccountDetail" Style="{StaticResource Hint}" Text="Connected through your Discord account." Margin="2,0,0,4"/>
    <DockPanel><Button x:Name="DashboardButton" Style="{StaticResource Ghost}" Content="Dashboard ↗" Margin="-6,0,0,0" ToolTip="Open the party dashboard in your browser"/><Button x:Name="LogoutButton" HorizontalAlignment="Right" Style="{StaticResource GhostDanger}" Content="Disconnect" ToolTip="Disconnect this app from your account"/></DockPanel>
   </StackPanel>

   <!-- Rooms: configured on the dashboard, summarized here -->
   <StackPanel x:Name="RoomsPanel" Visibility="Collapsed">
    <TextBlock Style="{StaticResource Section}" Text="ROOMS &amp; SHARING"/>
    <TextBlock Style="{StaticResource Hint}" Text="Rooms, invitations and which characters each room sees are set on the dashboard. Changes show up here on their own." Margin="2,0,0,4"/>
    <ItemsControl x:Name="SharingList" Focusable="False">
     <ItemsControl.ItemTemplate><DataTemplate>
      <StackPanel Margin="2,6,0,0">
       <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding Rooms}" Style="{StaticResource Hint}" Margin="0,1,0,0"/>
      </StackPanel>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="NoRoomsLabel" Style="{StaticResource Hint}" Margin="2,4,0,0"/>
    <Button x:Name="ManageButton" Style="{StaticResource Secondary}" Content="Manage rooms &amp; sharing ↗" Margin="0,10,0,0" ToolTip="Open My rooms &amp; characters on the dashboard"/>
   </StackPanel>

   <!-- Reader -->
   <TextBlock Style="{StaticResource Section}" Text="PACKET READER"/>
   <!-- Npcap is checked each time settings open -->
   <DockPanel><Button x:Name="NpcapButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Npcap setup ↗" VerticalAlignment="Center" ToolTip="Npcap must be installed for packet reading"/><Ellipse x:Name="NpcapDot" DockPanel.Dock="Left" Width="7" Height="7" Fill="{StaticResource Faint}" Margin="2,1,7,0" VerticalAlignment="Center"/><TextBlock x:Name="NpcapLabel" Text="Checking Npcap…" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
   <!-- Scope notice, the same text as on the installer's welcome page and the dashboard -->
   <TextBlock Style="{StaticResource Hint}" Text="Odyle is an unofficial fan project, not affiliated with or endorsed by NCSOFT. The Windows reader only listens to your own game connection: it never reads game memory, changes or sends game traffic, automates play or collects combat data. NCSOFT's rules ban unauthorized programs, so use Odyle at your own risk." Margin="2,6,0,0"/>

   <!-- Window: how the card is shown on this PC; the header buttons toggle the same -->
   <TextBlock Style="{StaticResource Section}" Text="WINDOW"/>
   <CheckBox x:Name="StayOnTopToggle" Content="Stay on top of other windows" ToolTip="Keeps the card above the game in windowed or borderless mode"/>
   <CheckBox x:Name="TasksToggle" Content="Show daily &amp; weekly tasks beside the card" Margin="0,8,0,0" ToolTip="Your checklist from the dashboard; tick tasks off here"/>
   <CheckBox x:Name="AutostartToggle" Content="Start with Windows" Margin="0,8,0,0" ToolTip="Starts Odyle in the tray when you sign in to Windows"/>
   <!-- The super compact strip: clicks through to the game, and the shortcut that switches it -->
   <CheckBox x:Name="ClickThroughToggle" Content="Let clicks pass through the compact strip" Margin="0,8,0,0" ToolTip="The strip ignores the mouse, so it can sit over the game. The tray menu and the shortcut still switch it off."/>
   <DockPanel Margin="0,8,0,0"><TextBlock DockPanel.Dock="Left" Style="{StaticResource FieldLabel}" Text="Compact strip shortcut" VerticalAlignment="Center" Margin="2,0,8,0"/><ComboBox x:Name="CompactHotkeyInput" DisplayMemberPath="Name" SelectedValuePath="Code" ToolTip="Switches between the card and the compact strip from anywhere"/></DockPanel>
   <TextBlock x:Name="HotkeyProblemLabel" Style="{StaticResource Hint}" Foreground="{StaticResource Amber}" TextWrapping="Wrap" Visibility="Collapsed" Margin="2,4,0,0"/>
   <TextBlock Style="{StaticResource Hint}" Text="Remembered on this PC, like where the window was. Started with Windows, Odyle waits in the tray. Tasks themselves are added and removed on the dashboard." Margin="2,6,0,0"/>

   <!-- Notifications: set for the account on the dashboard; planned runs show here, also while Odyle waits in the tray -->
   <TextBlock Style="{StaticResource Section}" Text="NOTIFICATIONS"/>
   <TextBlock Style="{StaticResource Hint}" Text="Run reminders, their times and quiet hours are set for your account on the dashboard. Odyle shows them here, also while it waits in the tray. A downloaded update is announced once." Margin="2,0,0,6"/>
   <Button x:Name="NotificationsButton" Content="Notification settings" HorizontalAlignment="Left" ToolTip="Open Account &amp; data on the dashboard"/>

   <!-- Language: automatic follows the Windows display language; a change applies after a restart -->
   <TextBlock Style="{StaticResource Section}" Text="LANGUAGE"/>
   <ComboBox x:Name="LanguageInput" DisplayMemberPath="Name" SelectedValuePath="Code" ToolTip="Language of Odyle on this PC"/>
   <DockPanel x:Name="LanguageRestartPanel" Visibility="Collapsed" Margin="0,6,0,0"><Button x:Name="LanguageRestartButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Restart now" VerticalAlignment="Center" ToolTip="Restarts Odyle in the chosen language · the reader stops for a moment"/><TextBlock Style="{StaticResource Hint}" Text="The new language applies when Odyle restarts." VerticalAlignment="Center" Margin="2,0,0,0"/></DockPanel>

   <!-- Updates: released builds download new GitHub releases and install them on restart -->
   <TextBlock Style="{StaticResource Section}" Text="UPDATES"/>
   <TextBlock x:Name="UpdateLabel" Style="{StaticResource Hint}" Margin="2,0,0,4"/>
   <DockPanel>
    <Button x:Name="ReleaseNotesButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Releases ↗" VerticalAlignment="Center" ToolTip="Odyle releases on GitHub"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="CheckUpdateButton" Style="{StaticResource Ghost}" Content="Check now" Margin="-6,0,0,0" ToolTip="Look for a newer release on GitHub"/>
     <Button x:Name="InstallUpdateButton" Style="{StaticResource Secondary}" Content="Restart &amp; update" Visibility="Collapsed" MinHeight="24" Padding="10,2" FontSize="11" ToolTip="Stops the reader, installs the downloaded version and starts it"/>
    </StackPanel>
   </DockPanel>
   <!-- Troubleshooting: a small log on this PC, never with tokens, device keys or pairing codes; diagnostics go to the clipboard only -->
   <TextBlock Style="{StaticResource Section}" Text="TROUBLESHOOTING"/>
   <TextBlock x:Name="DiagnosticsLabel" Style="{StaticResource Hint}" Text="Odyle keeps a small log on this PC. Copy diagnostics puts the version, the Npcap check, the reader's last states and the end of the log on the clipboard. Tokens, device keys, pairing codes, your account id, this PC's name and your Windows user name are left out; character names and the server address stay in." Margin="2,0,0,4"/>
   <DockPanel><Button x:Name="LogButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Open log folder ↗" VerticalAlignment="Center" ToolTip="The log helps when something does not work · it holds no tokens, device keys or pairing codes"/><Button x:Name="DiagnosticsButton" HorizontalAlignment="Left" Style="{StaticResource Ghost}" Content="Copy diagnostics" Margin="-6,0,0,0" VerticalAlignment="Center" ToolTip="A short report for a bug report · nothing is sent until you paste it somewhere"/></DockPanel>
  </StackPanel>
 </ScrollViewer>
</Window>
