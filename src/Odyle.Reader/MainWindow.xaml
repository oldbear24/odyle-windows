<Window x:Class="Odyle.Reader.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Odyle" SizeToContent="WidthAndHeight" ResizeMode="CanMinimize" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
 Icon="pack://application:,,,/Odyle;component/Assets/odyle.ico" WindowStartupLocation="CenterScreen" Closing="Window_Closing" SizeChanged="Window_SizeChanged" LocationChanged="Window_LocationChanged"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <!-- The compact 280 px card; the checklist opens beside it and the window grows to the right -->
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Grid x:Name="Card">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <!-- Header: pin above other windows, open the checklist, settings -->
   <DockPanel Margin="12,7,6,2">
    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="⚙" FontSize="14" Padding="7,1" Click="Settings_Click" VerticalAlignment="Center" ToolTip="Settings · account, rooms and reader setup"/>
    <Button x:Name="TasksButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE73A;" Click="Tasks_Click" ToolTip="Show your daily &amp; weekly tasks beside the card"/>
    <Button x:Name="PinButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE718;" Click="Pin_Click" ToolTip="Stay on top of other windows"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Viewbox Width="15" Height="15" Margin="0,1,6,0"><Canvas Width="24" Height="24"><Path Data="M12 2 L20 12 L12 22 L4 12 Z" Fill="#2EB5F2CD" Stroke="{StaticResource Mint}" StrokeThickness="2" StrokeLineJoin="Round"/><Path Data="M12 2 V22 M4 12 L12 15.6 L20 12" Stroke="{StaticResource Mint}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
     <TextBlock Text="odyle" FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Center"/><TextBlock Text="." FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Mint}" VerticalAlignment="Center"/>
     <TextBlock x:Name="AccountLabel" Style="{StaticResource Eyebrow}" Text="NOT CONNECTED" Margin="9,3,0,0" VerticalAlignment="Center" MaxWidth="104" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </DockPanel>

   <StackPanel Grid.Row="1" Margin="12,3,12,8">
    <!-- Announcement from the server (Server controls on the dashboard's superuser pages) -->
    <Border x:Name="AnnouncementBar" Visibility="Collapsed" CornerRadius="8" BorderThickness="1" Padding="9,5,3,5" Margin="0,0,0,6">
     <DockPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="✕" FontSize="10" Padding="5,0" VerticalAlignment="Top" Click="HideAnnouncement_Click" ToolTip="Hide until the message changes"/>
      <TextBlock x:Name="AnnouncementText" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>
    <!-- Reading card: the character the game reports -->
    <Border CornerRadius="10" BorderThickness="1" BorderBrush="#2B3F33" Padding="12,8,12,8">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C2B21" Offset="0"/><GradientStop Color="#131C16" Offset="1"/></LinearGradientBrush></Border.Background>
     <StackPanel>
      <DockPanel>
       <Border x:Name="StatePill" DockPanel.Dock="Right" CornerRadius="999" Padding="7,2" Background="{StaticResource PillNeutral}" VerticalAlignment="Center" Margin="8,0,0,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Width="5" Height="5" Fill="{StaticResource Faint}" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock x:Name="StateText" Text="Offline" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel></Border>
       <TextBlock x:Name="HeroTitle" Text="Not connected" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="8,0,0,5"><TextBlock x:Name="CubeLabel" FontSize="10.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/><TextBlock x:Name="AgeLabel" FontSize="10" Foreground="{StaticResource Faint}" HorizontalAlignment="Right"/></StackPanel>
       <StackPanel Orientation="Horizontal"><TextBlock x:Name="ValueLabel" Text="—" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" Margin="-1,0,0,0"/><TextBlock Text="Odyle" Foreground="{StaticResource Muted}" FontSize="11" Margin="6,0,0,6" VerticalAlignment="Bottom"/></StackPanel>
      </DockPanel>
      <ProgressBar x:Name="EnergyTrack" Height="4" Margin="0,2,0,0" Maximum="100" Value="0"/>
      <TextBlock x:Name="SplitLabel" FontSize="10" Foreground="{StaticResource Faint}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
      <TextBlock x:Name="OdyleClockLabel" FontSize="10" Foreground="{StaticResource Mint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
      <TextBlock x:Name="ReadingLabel" Text="Open settings to pair with the dashboard." Foreground="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
     </StackPanel>
    </Border>

    <!-- Packet reader: status line with a compact start/stop toggle -->
    <!-- Packet counts sit in the status tooltip while the reader runs; without a working Npcap the line links to its download -->
    <DockPanel Margin="0,7,0,0">
     <Button x:Name="ReportButton" DockPanel.Dock="Right" Content="Connect" Click="Reader_Click" Margin="8,0,0,0" MinHeight="22" Padding="10,2" FontSize="11" VerticalAlignment="Center" ToolTip="Reads the game's own packets with Npcap. Nothing is injected."/>
     <StackPanel VerticalAlignment="Center">
      <DockPanel x:Name="ReaderRow" Background="Transparent" ToolTipService.IsEnabled="False">
       <DockPanel.ToolTip><TextBlock x:Name="CaptureStatsLabel"/></DockPanel.ToolTip>
       <Ellipse x:Name="ReaderDot" DockPanel.Dock="Left" Width="7" Height="7" Fill="{StaticResource Faint}" Margin="2,4,7,0" VerticalAlignment="Top"/><TextBlock x:Name="PacketStateLabel" Text="Stopped · start the reader before logging in." Foreground="{StaticResource Muted}" FontSize="10.5" TextWrapping="Wrap"/>
      </DockPanel>
      <Button x:Name="NpcapLink" Style="{StaticResource Ghost}" Content="Install Npcap ↗" Visibility="Collapsed" Click="NpcapLink_Click" HorizontalAlignment="Left" Margin="10,1,0,0" Padding="4,1" FontSize="10.5" Foreground="{StaticResource Mint}" ToolTip="Opens npcap.com · Odyle starts reading by itself once Npcap is installed"/>
     </StackPanel>
    </DockPanel>

    <!-- After the first live reading, once per PC: an offer to start with Windows (remembered in preferences.json) -->
    <Border x:Name="AutostartOffer" Visibility="Collapsed" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource LineStrong}" Background="{StaticResource PillLive}" Padding="9,6,6,6" Margin="0,7,0,0">
     <StackPanel>
      <TextBlock Text="Start Odyle with Windows? It waits in the tray, so the reader runs before you log into the game." TextWrapping="Wrap" FontSize="11"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
       <Button Style="{StaticResource Ghost}" Content="No thanks" Click="DeclineAutostart_Click" VerticalAlignment="Center" Margin="0,0,4,0"/>
       <Button Style="{StaticResource Secondary}" Content="Start with Windows" Click="AcceptAutostart_Click" MinHeight="22" Padding="10,2" FontSize="11" ToolTip="Starts Odyle in the tray when you sign in to Windows"/>
      </StackPanel>
     </StackPanel>
    </Border>

    <!-- Party: other members' characters that are online in your rooms, one header per room -->
    <StackPanel x:Name="PartyPanel" Visibility="Collapsed" Margin="0,4,0,0">
     <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <ItemsControl x:Name="PartyList" Focusable="False">
       <ItemsControl.ItemTemplate><DataTemplate>
        <StackPanel>
         <DockPanel Margin="2,6,2,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Online}" FontSize="10" Foreground="{StaticResource Faint}" Margin="8,0,0,0"/><TextBlock Style="{StaticResource Eyebrow}" Text="{Binding Header}" TextTrimming="CharacterEllipsis"/></DockPanel>
         <ItemsControl ItemsSource="{Binding Mates}" Focusable="False">
          <ItemsControl.ItemTemplate><DataTemplate>
           <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="8,4" Margin="0,3,0,0" ToolTip="{Binding Hint}">
            <DockPanel>
             <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Cubes}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,1,7,0"/><TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
             <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{Binding Dot}" Margin="0,0,7,0" VerticalAlignment="Center"/>
             <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Detail, Mode=OneWay}" FontSize="10" Foreground="{StaticResource Faint}"/></TextBlock>
            </DockPanel>
           </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
     <TextBlock x:Name="PartyEmptyLabel" Style="{StaticResource Hint}" Text="No one else is online in your rooms." Margin="2,6,0,0"/>
    </StackPanel>
   </StackPanel>

   <!-- Footer -->
   <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,4,6,4">
    <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Quit" Click="Quit_Click" Padding="6,1" VerticalAlignment="Center" ToolTip="Quit Odyle completely · closing the window keeps it in the tray"/><Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Foreground="{StaticResource Mint}" Content="Restart to update" Visibility="Collapsed" Click="Install_Click" Padding="6,1" VerticalAlignment="Center"/><TextBlock x:Name="StatusLabel" Text="Your connection is remembered on this PC." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="10.5" VerticalAlignment="Center"/></DockPanel>
   </Border>
  </Grid>

  <!-- Daily & weekly: the account's own checklist from the dashboard, ticked off here -->
  <!-- Tasks are added and removed on the dashboard; each list clears itself at the game's reset -->
  <Border x:Name="TasksPanel" Grid.Column="1" Width="240" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
   <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="12,9,6,2">
     <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Manage ↗" Click="ManageTasks_Click" VerticalAlignment="Center" ToolTip="Add, rename or remove tasks on the dashboard"/>
     <TextBlock Style="{StaticResource Eyebrow}" Text="DAILY &amp; WEEKLY" VerticalAlignment="Center" Margin="0,3,0,0"/>
    </DockPanel>
    <TextBlock x:Name="TasksHint" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="12,6,12,10"/>
    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="12,2,6,0">
     <ItemsControl x:Name="TaskGroups" Focusable="False">
      <ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel Margin="0,2,0,6">
        <DockPanel Margin="2,6,2,0" Background="Transparent" ToolTip="{Binding ResetAt}">
         <TextBlock DockPanel.Dock="Right" Text="{Binding Reset}" FontSize="10" Foreground="{StaticResource Faint}" Margin="8,0,0,0"/>
         <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{Binding Header, Mode=OneWay}"/><Run Text="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource Muted}" FontWeight="Normal"/></TextBlock>
        </DockPanel>
        <ProgressBar Height="3" Margin="2,5,2,3" Maximum="100" Value="{Binding Percent, Mode=OneWay}"/>
        <ItemsControl ItemsSource="{Binding Tasks}" Focusable="False">
         <ItemsControl.ItemTemplate><DataTemplate>
          <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding Done, Mode=OneWay}" Click="Task_Click" Tag="{Binding}" ToolTip="{Binding Hint}">
           <TextBlock x:Name="Title" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
          </CheckBox>
          <DataTemplate.Triggers><DataTrigger Binding="{Binding Done}" Value="True"><Setter TargetName="Title" Property="Foreground" Value="{StaticResource Faint}"/><Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough"/></DataTrigger></DataTemplate.Triggers>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Empty}" Style="{StaticResource Hint}" Visibility="{Binding EmptyVisibility}" Margin="2,4,0,0"/>
       </StackPanel>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </DockPanel>
  </Border>
 </Grid>
</Window>
