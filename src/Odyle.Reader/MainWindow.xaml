<Window x:Class="Odyle.Reader.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Odyle · Your party companion" Width="540" Height="900" MinWidth="460" MinHeight="650" Background="#101814" Foreground="#E7F2EA" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" Closing="Window_Closing" Loaded="Window_Loaded">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26">
<DockPanel><TextBlock Text="◈ odyle." FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Mint}"/><TextBlock Text="WINDOWS COMPANION" FontSize="10" Foreground="#8DA796" VerticalAlignment="Center" Margin="20,0,0,0"/></DockPanel>
<TextBlock Text="One Discord account. Every character, saved." Foreground="#A0B6A7" Margin="0,10,0,24"/>
<Border Background="#1D2B22" BorderBrush="#385141" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel><TextBlock x:Name="AccountLabel" Text="Pair your Discord account" Foreground="#A9C3B1" FontSize="12"/><TextBlock x:Name="ValueLabel" Text="—" FontSize="42" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="ReadingLabel" Text="No character selected" Foreground="#95AF9D" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="StatusLabel" Text="Sign in with Discord on the dashboard, then generate a Windows pairing code." TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12"/></StackPanel></Border>
<StackPanel x:Name="JoinPanel" Margin="0,22,0,0"><TextBlock Text="PAIR WITH YOUR ACCOUNT" FontSize="10" Foreground="#8FAA99"/><TextBlock Text="PocketBase server" Margin="0,15,0,0" FontSize="12"/><TextBox x:Name="EndpointInput" Text="http://127.0.0.1:8090"/><Button Content="Open dashboard · Sign in with Discord" Click="Dashboard_Click" Background="#5865F2" Foreground="White"/><TextBlock Text="One-time Windows pairing code" Margin="0,12,0,0" FontSize="12"/><PasswordBox x:Name="CodeInput"/><Button x:Name="JoinButton" Content="Pair this Windows app →" Click="Pair_Click"/></StackPanel>
<StackPanel x:Name="ReaderPanel" IsEnabled="False" Margin="0,18,0,0"><TextBlock Text="Your saved characters" FontSize="12"/><ComboBox x:Name="CharactersInput" DisplayMemberPath="Label" SelectionChanged="Character_Changed" Margin="0,6,0,10" Padding="8"/><Button Content="Add another character / switch" Click="Switch_Click" Background="#293D30" Foreground="#BCD8C5"/><StackPanel x:Name="IdentityPanel"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Character" FontSize="12"/><TextBox x:Name="CharacterInput" MaxLength="40"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Server" FontSize="12"/><TextBox x:Name="ServerInput" MaxLength="40"/></StackPanel></Grid><TextBlock Text="Global region" FontSize="12"/><ComboBox x:Name="RegionInput" SelectedIndex="0" Margin="0,6,0,15" Padding="8"><ComboBoxItem Content="Global EU" Tag="GLOBAL_EU"/><ComboBoxItem Content="Global NA" Tag="GLOBAL_NA"/><ComboBoxItem Content="Global SA" Tag="GLOBAL_SA"/><ComboBoxItem Content="Global Asia" Tag="GLOBAL_ASIA"/></ComboBox></StackPanel><TextBlock Text="Current Odyle Energy" FontSize="12"/><TextBox x:Name="OdyleInput"/><CheckBox x:Name="ConfirmToggle" Content="I checked this character’s total in the game"/><Button x:Name="ReportButton" Content="Confirm &amp; save to my account →" Click="Report_Click"/><TextBlock Text="Share with a room" Margin="0,20,0,0" FontSize="12"/><ComboBox x:Name="RoomsInput" DisplayMemberPath="Name" SelectionChanged="Room_Changed" Margin="0,6,0,8" Padding="8"/><CheckBox x:Name="ShareToggle" Content="Share my saved characters with this room" Click="Share_Click"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><PasswordBox x:Name="InviteInput"/><Button Grid.Column="2" Content="Join room" Click="JoinRoom_Click"/></Grid><TextBlock Text="Enter a room invite above. Your character history stays on your account." FontSize="10" Foreground="#829D8B" TextWrapping="Wrap"/><Button Content="Sign out of this Windows app" Click="Logout_Click" Background="#293D30" Foreground="#BCD8C5"/></StackPanel>
<Border BorderBrush="#304538" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,18,0,0"><StackPanel><TextBlock Text="MANUAL MODE · AUTOMATIC READER UNAVAILABLE" FontSize="10" Foreground="#D2BC86"/><TextBlock Text="Last confirmed values are stored for every character. Older readings remain saved but do not count as ready. This app never stores Discord credentials. Close the window to keep it in the tray." FontSize="11" Foreground="#829D8B" TextWrapping="Wrap" Margin="0,9,0,0"/><Button Content="Quit companion" Click="Quit_Click" Background="Transparent" Foreground="#9CB6A5" HorizontalAlignment="Left" Padding="0,10"/></StackPanel></Border>
</StackPanel></ScrollViewer></Window>
