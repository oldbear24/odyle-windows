<Window x:Class="Odyle.Reader.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Odyle" Width="380" Height="610" MinWidth="340" MinHeight="460" Background="#101814" Foreground="#E7F2EA" FontFamily="Segoe UI"
 WindowStartupLocation="CenterScreen" Closing="Window_Closing" Loaded="Window_Loaded" KeyDown="Window_KeyDown">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="22,18">
  <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="Dashboard ↗" Click="Dashboard_Click" Background="Transparent" Foreground="#9DB6A6" FontSize="11" Padding="4,6" HorizontalAlignment="Right"/><TextBlock Text="◈ odyle." FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Mint}" VerticalAlignment="Center"/></DockPanel>
  <Border Background="#1D2B22" BorderBrush="#385141" BorderThickness="1" CornerRadius="8" Padding="16,12">
   <StackPanel><TextBlock x:Name="AccountLabel" Text="Connect your Discord account" Foreground="#A9C3B1" FontSize="12" TextTrimming="CharacterEllipsis"/><DockPanel Margin="0,4,0,2"><TextBlock x:Name="ValueLabel" Text="—" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="Odyle" Foreground="#95AF9D" FontSize="12" Margin="10,0,0,5" VerticalAlignment="Bottom"/></DockPanel><TextBlock x:Name="ReadingLabel" Text="Your characters stay saved." Foreground="#95AF9D" FontSize="11" TextWrapping="Wrap"/></StackPanel>
  </Border>
  <StackPanel x:Name="JoinPanel" Margin="0,18,0,0">
   <TextBlock Text="Connect in one paste" FontSize="17" FontWeight="SemiBold"/>
   <TextBlock Text="Sign in on the dashboard, open Pair Windows app, then copy your connection link." TextWrapping="Wrap" Foreground="#9DB6A6" FontSize="12" Margin="0,8,0,10"/>
   <Button x:Name="PasteButton" Content="Paste link &amp; connect" Click="PasteConnect_Click"/>
   <TextBlock Text="Or paste the link / pairing code here" FontSize="11" Foreground="#8FAA99" Margin="0,8,0,0"/>
   <PasswordBox x:Name="CodeInput" ToolTip="Connection link or 16-character Windows pairing code" Margin="0,5,0,5"/>
   <Button x:Name="JoinButton" Content="Connect" Click="Pair_Click" Background="#293D30" Foreground="#BCD8C5" Margin="0,3,0,6"/>
   <Expander x:Name="ServerOptions" Header="Server address · for code-only pairing" Foreground="#9DB6A6" FontSize="11" Margin="0,8,0,0">
    <StackPanel Margin="0,8,0,0"><TextBox x:Name="EndpointInput" Text="http://127.0.0.1:8090" ToolTip="PocketBase server address" Margin="0,4,0,6"/><Button x:Name="RetryButton" Content="Reconnect saved account" Click="Retry_Click" Visibility="Collapsed" Background="#293D30" Foreground="#BCD8C5"/></StackPanel>
   </Expander>
  </StackPanel>
  <StackPanel x:Name="ReaderPanel" Visibility="Collapsed" IsEnabled="False" Margin="0,16,0,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions><Grid><ComboBox x:Name="CharactersInput" DisplayMemberPath="Label" SelectionChanged="Character_Changed" Padding="8" ToolTip="Your saved characters"/><TextBlock x:Name="NoCharactersLabel" Text="No characters yet" Foreground="#8FAA99" Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12"/></Grid><Button Grid.Column="2" Content="+ Add" Click="Switch_Click" Padding="0,6" Margin="0" ToolTip="Add a character" Background="#293D30" Foreground="#BCD8C5"/></Grid>
   <Expander x:Name="CharacterDetails" Header="Character details" Foreground="#9DB6A6" FontSize="11" Margin="0,10,0,4">
    <StackPanel x:Name="IdentityPanel" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Character" FontSize="11"/><TextBox x:Name="CharacterInput" MaxLength="40" Margin="0,4,0,8"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Server" FontSize="11"/><TextBox x:Name="ServerInput" MaxLength="40" Margin="0,4,0,8"/></StackPanel></Grid><ComboBox x:Name="RegionInput" SelectedIndex="0" Padding="8" Margin="0,0,0,8"><ComboBoxItem Content="Global EU" Tag="GLOBAL_EU"/><ComboBoxItem Content="Global NA" Tag="GLOBAL_NA"/><ComboBoxItem Content="Global SA" Tag="GLOBAL_SA"/><ComboBoxItem Content="Global Asia" Tag="GLOBAL_ASIA"/></ComboBox><Button x:Name="SaveCharacterButton" Content="Save character" Click="SaveCharacter_Click" Margin="0,2,0,4"/><Button x:Name="CancelCharacterButton" Content="Cancel" Click="CancelCharacter_Click" Background="Transparent" Foreground="#9DB6A6" Padding="4,4" Margin="0,0,0,4" Visibility="Collapsed"/></StackPanel>
   </Expander>
   <TextBlock Text="PACKET READER" Foreground="#8FAA99" FontSize="10" Margin="0,12,0,0"/>
   <TextBlock x:Name="PacketStateLabel" Text="Stopped · no verified Global adapter yet" Foreground="#D2BC86" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,6"/>
   <Button x:Name="ReportButton" Content="Start packet reader" Click="Reader_Click"/>
   <Button Content="Npcap setup ↗" Click="Npcap_Click" Background="Transparent" Foreground="#9CB6A5" FontSize="11" Padding="4,3" Margin="0,0,0,4"/>
   <Expander Header="Room sharing" Foreground="#9DB6A6" FontSize="11" Margin="0,10,0,0">
    <StackPanel Margin="0,8,0,0"><ComboBox x:Name="RoomsInput" DisplayMemberPath="Name" SelectionChanged="Room_Changed" Padding="8"/><CheckBox x:Name="ShareToggle" FontSize="11" Click="Share_Click"><TextBlock Text="Share my characters in this room" TextWrapping="Wrap"/></CheckBox><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><PasswordBox x:Name="InviteInput" Margin="0,4,0,4" ToolTip="Room invitation code"/><Button Grid.Column="2" Content="Join room" Click="JoinRoom_Click" FontSize="11" Padding="8,6" Margin="0,4,0,4"/></Grid></StackPanel>
   </Expander>
   <Expander Header="Account" Foreground="#9DB6A6" FontSize="11" Margin="0,10,0,0"><Button Content="Disconnect this app" Click="Logout_Click" Background="#293D30" Foreground="#BCD8C5"/></Expander>
  </StackPanel>
  <TextBlock x:Name="StatusLabel" Text="Your connection is remembered on this PC." Foreground="#B8CCBF" TextWrapping="Wrap" FontSize="11" Margin="0,14,0,0"/>
  <DockPanel Margin="0,16,0,0"><Button DockPanel.Dock="Right" Content="Quit" Click="Quit_Click" Background="Transparent" Foreground="#9CB6A5" FontSize="11" Padding="4,0" Margin="0"/><TextBlock Text="Packets only · close to keep in tray" FontSize="10" Foreground="#829D8B" VerticalAlignment="Center"/></DockPanel>
 </StackPanel></ScrollViewer>
</Window>
