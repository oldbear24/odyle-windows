<Window x:Class="Odyle.Reader.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Odyle · Your party companion" Width="520" Height="830" MinWidth="460" MinHeight="640" Background="#101814" Foreground="#E7F2EA" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" Closing="Window_Closing" Loaded="Window_Loaded">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,26">
<DockPanel><TextBlock Text="◈ odyle." FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Mint}"/><TextBlock Text="WINDOWS COMPANION" FontSize="10" Foreground="#8DA796" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0,0,0"/></DockPanel>
<TextBlock Text="Your energy. Your next adventure." Foreground="#A0B6A7" Margin="0,10,0,24"/>
<Border Background="#1D2B22" BorderBrush="#385141" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel><TextBlock x:Name="RoomLabel" Text="Not connected to a party" Foreground="#A9C3B1" FontSize="12"/><TextBlock x:Name="ValueLabel" Text="—" FontSize="42" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="ReadingLabel" Text="No confirmed Odyle reading" Foreground="#95AF9D" FontSize="12"/><TextBlock x:Name="StatusLabel" Text="Join a private room to begin." TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12"/></StackPanel></Border>
<StackPanel x:Name="JoinPanel" Margin="0,22,0,0"><TextBlock Text="CONNECT TO YOUR PARTY" FontSize="10" Foreground="#8FAA99"/><TextBlock Text="PocketBase server" Margin="0,15,0,0" FontSize="12"/><TextBox x:Name="EndpointInput" Text="http://127.0.0.1:8090"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Player invite code" FontSize="12"/><PasswordBox x:Name="CodeInput"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Display name" FontSize="12"/><TextBox x:Name="NameInput" MaxLength="40"/></StackPanel></Grid><Button x:Name="JoinButton" Content="Join private room →" Click="Join_Click"/></StackPanel>
<StackPanel x:Name="ReaderPanel" IsEnabled="False" Margin="0,18,0,0"><CheckBox x:Name="ShareToggle" Content="Share my Odyle with this room" Click="Share_Click"/><StackPanel x:Name="IdentityPanel"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Character" FontSize="12"/><TextBox x:Name="CharacterInput" MaxLength="40"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Server" FontSize="12"/><TextBox x:Name="ServerInput" MaxLength="40"/></StackPanel></Grid><TextBlock Text="Global region" FontSize="12"/><ComboBox x:Name="RegionInput" SelectedIndex="0" Margin="0,6,0,15" Padding="8"><ComboBoxItem Content="Global EU" Tag="GLOBAL_EU"/><ComboBoxItem Content="Global NA" Tag="GLOBAL_NA"/><ComboBoxItem Content="Global SA" Tag="GLOBAL_SA"/><ComboBoxItem Content="Global Asia" Tag="GLOBAL_ASIA"/></ComboBox></StackPanel><Button Content="Switch character / clear reading" Click="Switch_Click" Background="#293D30" Foreground="#BCD8C5"/><TextBlock Text="Current Odyle Energy" Margin="0,10,0,0" FontSize="12"/><TextBox x:Name="OdyleInput"/><CheckBox x:Name="ConfirmToggle" Content="I checked this total in the game"/><Button x:Name="ReportButton" Content="Confirm &amp; share Odyle →" Click="Report_Click"/><Button Content="Leave room" Click="Leave_Click" Background="#293D30" Foreground="#BCD8C5"/></StackPanel>
<Border BorderBrush="#304538" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,18,0,0"><StackPanel><TextBlock Text="MANUAL MODE · AUTOMATIC READER UNAVAILABLE" FontSize="10" Foreground="#D2BC86"/><TextBlock Text="Automatic game reading needs verified Global fixtures. This app sends only your own confirmed manual total. Readings become stale after 45 seconds. Close this window to keep the app in your tray." FontSize="11" Foreground="#829D8B" TextWrapping="Wrap" Margin="0,9,0,0"/><Button Content="Quit companion" Click="Quit_Click" Background="Transparent" Foreground="#9CB6A5" HorizontalAlignment="Left" Padding="0,10"/></StackPanel></Border>
</StackPanel></ScrollViewer></Window>
