<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings><AssemblyName>Odyle</AssemblyName><Version>0.8.0</Version><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets/odyle.ico</ApplicationIcon></PropertyGroup>
  <ItemGroup><ProjectReference Include="../Odyle.Core/Odyle.Core.csproj"/></ItemGroup>
  <ItemGroup><Resource Include="Assets/odyle.ico"/></ItemGroup>
  <!-- The publish script sets SelfContained; the updater reads it to fetch the same package kind. -->
  <ItemGroup><AssemblyMetadata Include="SelfContained" Value="$(SelfContained)"/></ItemGroup>
</Project>
