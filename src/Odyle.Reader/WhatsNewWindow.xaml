<Window x:Class="Odyle.Reader.WhatsNewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="What's new in Odyle" Width="380" Height="560" MinWidth="300" MinHeight="260" ResizeMode="CanResize" WindowStyle="None" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
 Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
 Icon="pack://application:,,,/Odyle;component/Assets/odyle.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
 <!-- What changed in each version, newest first, from the CHANGELOG.md built into the app. In the card's style: frameless,
      dragged by its header and resized by its edges, each version a glass tile under its number and date. -->
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Border x:Name="RootBorder" BorderBrush="#26352C" BorderThickness="0">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="16,12,10,4" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
    <Button DockPanel.Dock="Right" Style="{StaticResource HeaderButton}" Content="&#xE711;" FontSize="10" Click="Close_Click" ToolTip="Close What's new"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Viewbox Width="14" Height="14" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Data="M12 2 L20 12 L12 22 L4 12 Z" Fill="#2EB5F2CD" Stroke="{StaticResource Mint}" StrokeThickness="2" StrokeLineJoin="Round"/><Path Data="M12 2 V22 M4 12 L12 15.6 L20 12" Stroke="{StaticResource Mint}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
     <TextBlock Text="What's new" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
   </DockPanel>
   <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel x:Name="Entries" Margin="14,0,14,16"/>
   </ScrollViewer>
  </Grid>
 </Border>
</Window>
