<Application x:Class="Odyle.Reader.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml" ShutdownMode="OnExplicitShutdown"><Application.Resources>
<SolidColorBrush x:Key="Mint" Color="#B5F2CD"/>
<Style TargetType="TextBox"><Setter Property="Background" Value="#111B15"/><Setter Property="Foreground" Value="#E7F2EA"/><Setter Property="BorderBrush" Value="#3B5042"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,5,0,13"/><Setter Property="FontSize" Value="13"/></Style>
<Style TargetType="PasswordBox"><Setter Property="Background" Value="#111B15"/><Setter Property="Foreground" Value="#E7F2EA"/><Setter Property="BorderBrush" Value="#3B5042"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,5,0,13"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#B5F2CD"/><Setter Property="Foreground" Value="#193223"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="13,10"/><Setter Property="Margin" Value="0,6,0,6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#CBDCCF"/><Setter Property="Margin" Value="0,8"/></Style>
</Application.Resources></Application>
