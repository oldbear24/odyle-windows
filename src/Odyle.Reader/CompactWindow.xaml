<Window x:Class="Odyle.Reader.CompactWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Odyle" Width="196" Height="46" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
 Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
 MouseLeftButtonDown="Strip_MouseLeftButtonDown" LocationChanged="Strip_LocationChanged">
 <!-- The super compact strip: the card's value, cubes and state dot, and one line of what matters next.
      Drag it anywhere; a double-click (or the shortcut, or the tray) returns to the full card. -->
 <Border x:Name="Strip" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource LineStrong}" Padding="9,3,9,4" ToolTip="Odyle · double-click for the full card">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EE1C2B21" Offset="0"/><GradientStop Color="#EE131C16" Offset="1"/></LinearGradientBrush></Border.Background>
  <StackPanel VerticalAlignment="Center">
   <DockPanel>
    <TextBlock x:Name="CubesText" DockPanel.Dock="Right" FontSize="10.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
    <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="6" Height="6" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,1,6,0"/>
    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run x:Name="ValueText" Text="—" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/><Run Text=" "/><Run x:Name="UnitText" Text="Odyle" FontSize="10" Foreground="{StaticResource Muted}"/></TextBlock>
   </DockPanel>
   <TextBlock x:Name="LineText" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
  </StackPanel>
 </Border>
</Window>
